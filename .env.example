# Base URL for the GARUDA backend API. Falls back to "/api" (same-origin) when unset.
VITE_API_BASE_URL=/api

# WebSocket / SSE endpoint for real-time events (alerts, geo events, pipeline status).
# Leave empty to keep eventService in its no-op state until a backend is available.
VITE_WS_URL=

# development | staging | production — surfaced in the admin-only Settings panel.
VITE_APP_ENV=development
